# Шаблон переменных окружения. Рабочий файл .env создаётся только на сервере
# (права 600) и в репозиторий не попадает:
#   umask 077; printf 'REDIS_PASSWORD=%s\n' "$(openssl rand -hex 32)" > .env
# Несекретные параметры (REDIS_HOST=redis, STUDENT=Likhtina) заданы в docker-compose.yml.
REDIS_PASSWORD=change_me
